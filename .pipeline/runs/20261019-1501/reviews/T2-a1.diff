+	t.Helper()
+	switch v := c.Value.(type) {
+	case nil:
+		return ""
+	case json.Number:
+		return v.String()
+	case string:
+		return v
+	default:
+		t.Fatalf("unexpected cell value type %T", c.Value)
+		return ""
+	}
+}
