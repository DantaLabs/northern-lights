diff --git a/cmd/nl-demo-seed/workiva.go b/cmd/nl-demo-seed/workiva.go
new file mode 100644
index 0000000..643f34c
--- /dev/null
+++ b/cmd/nl-demo-seed/workiva.go
@@ -0,0 +1,147 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"time"
+
+	"github.com/dantalabs/northern-lights/internal/ratelimit"
+	"github.com/dantalabs/northern-lights/internal/workiva"
+)
+
+// newWorkiva builds the live client from the environment. It is a seam:
+// tests replace it with a fake, and a dry run never calls it.
+var newWorkiva = func(context.Context) (Workiva, error) {
+	return newLiveWorkivaFromEnv(os.Getenv)
+}
+
+// regionBaseURLs mirrors baseURLs in internal/config/config.go.
+var regionBaseURLs = map[string]string{
+	"eu":   "https://api.eu.wdesk.com",
+	"us":   "https://api.app.wdesk.com",
+	"apac": "https://api.apac.wdesk.com",
+}
+
+func regionBaseURL(region string) (*url.URL, error) {
+	if region == "" {
+		region = "eu"
+	}
+	raw, ok := regionBaseURLs[region]
+	if !ok {
+		return nil, fmt.Errorf("NL_REGION %q is not one of eu, us, apac", region)
+	}
+	return url.Parse(raw)
+}
+
+// newLiveWorkivaFromEnv reads NL_WORKIVA_CLIENT_ID, NL_WORKIVA_CLIENT_SECRET
+// and NL_REGION (default eu) through getenv. Errors name a variable, never
+// its value.
+func newLiveWorkivaFromEnv(getenv func(string) string) (*liveWorkiva, error) {
+	id := getenv("NL_WORKIVA_CLIENT_ID")
+	if id == "" {
+		return nil, errors.New("NL_WORKIVA_CLIENT_ID is not set")
+	}
+	secret := getenv("NL_WORKIVA_CLIENT_SECRET")
+	if secret == "" {
+		return nil, errors.New("NL_WORKIVA_CLIENT_SECRET is not set")
+	}
+	base, err := regionBaseURL(getenv("NL_REGION"))
+	if err != nil {
+		return nil, err
+	}
+	return newLiveWorkivaAt(base, id, secret, &http.Client{Timeout: 60 * time.Second}), nil
+}
+
+// newLiveWorkivaAt builds the client the way cmd/workiva-mcp buildServer does.
+func newLiveWorkivaAt(base *url.URL, id, secret string, hc *http.Client) *liveWorkiva {
+	tokens := workiva.NewTokenProvider(base, id, secret, "file:read file:write", hc)
+	return &liveWorkiva{Client: workiva.NewClient(base, tokens, ratelimit.NewLimiter(), hc), base: base}
+}
+
+// liveWorkiva adds the section calls the seed needs to *workiva.Client. The
+// report document writer in internal/workiva has no delete, so they live here.
+type liveWorkiva struct {
+	*workiva.Client
+	base *url.URL
+}
+
+type sectionsPage struct {
+	Data []struct {
+		ID   string `json:"id"`
+		Name string `json:"name"`
+	} `json:"data"`
+	NextLink string `json:"@nextLink"`
+}
+
+// ListSections returns every section of the report document, following
+// @nextLink.
+func (l *liveWorkiva) ListSections(ctx context.Context, documentID string) ([]Section, error) {
+	path := "/documents/" + url.PathEscape(documentID) + "/sections?$maxpagesize=100"
+	var out []Section
+	for path != "" {
+		page, err := l.sectionsPage(ctx, path)
+		if err != nil {
+			return nil, err
+		}
+		for _, s := range page.Data {
+			out = append(out, Section{ID: s.ID, Name: s.Name})
+		}
+		path, err = l.relativeLink(page.NextLink)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return out, nil
+}
+
+func (l *liveWorkiva) sectionsPage(ctx context.Context, path string) (*sectionsPage, error) {
+	resp, err := l.Do(ctx, http.MethodGet, path, nil, ratelimit.CategoryReads)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("list sections: HTTP %d", resp.StatusCode)
+	}
+	var page sectionsPage
+	if err := json.NewDecoder(resp.Body).Decode(&page); err != nil {
+		return nil, fmt.Errorf("list sections: decode: %w", err)
+	}
+	return &page, nil
+}
+
+// relativeLink turns an absolute @nextLink into a path on the API host. A
+// link to another host is refused, so the access token is never sent there.
+func (l *liveWorkiva) relativeLink(link string) (string, error) {
+	if link == "" {
+		return "", nil
+	}
+	u, err := url.Parse(link)
+	if err != nil {
+		return "", fmt.Errorf("list sections: bad @nextLink: %w", err)
+	}
+	if u.IsAbs() && (u.Scheme != l.base.Scheme || u.Host != l.base.Host) {
+		return "", errors.New("list sections: @nextLink points to another host")
+	}
+	return u.RequestURI(), nil
+}
+
+// DeleteSection deletes one section of the report document; Workiva answers
+// 204.
+func (l *liveWorkiva) DeleteSection(ctx context.Context, documentID, sectionID string) error {
+	path := "/documents/" + url.PathEscape(documentID) + "/sections/" + url.PathEscape(sectionID)
+	resp, err := l.Do(ctx, http.MethodDelete, path, nil, ratelimit.CategoryWrites)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusNoContent {
+		return fmt.Errorf("delete section: HTTP %d", resp.StatusCode)
+	}
+	return nil
+}
diff --git a/cmd/nl-demo-seed/workiva_test.go b/cmd/nl-demo-seed/workiva_test.go
new file mode 100644
index 0000000..ea4e349
--- /dev/null
+++ b/cmd/nl-demo-seed/workiva_test.go
@@ -0,0 +1,166 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"strings"
+	"testing"
+)
+
+// errRealClientInTest is what the default newWorkiva returns during unit
+// tests: no test can build the real client or reach the network, even when
+// credentials are in the environment. A test that needs a Workiva replaces
+// newWorkiva with a fake.
+var errRealClientInTest = errors.New("real Workiva client is disabled in unit tests; replace newWorkiva with a fake")
+
+func TestMain(m *testing.M) {
+	newWorkiva = func(context.Context) (Workiva, error) { return nil, errRealClientInTest }
+	os.Exit(m.Run())
+}
+
+// fakeSeam installs wk (or err) as the result of newWorkiva for one test.
+func fakeSeam(t *testing.T, wk Workiva, err error) {
+	t.Helper()
+	old := newWorkiva
+	newWorkiva = func(context.Context) (Workiva, error) { return wk, err }
+	t.Cleanup(func() { newWorkiva = old })
+}
+
+func TestLiveWorkivaSections(t *testing.T) {
+	var deletes []string
+	var srv *httptest.Server
+	srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodPost && r.URL.Path == "/iam/v1/oauth2/token":
+			_, _ = w.Write([]byte(`{"access_token":"t","expires_in":3600}`))
+		case r.Method == http.MethodGet && r.URL.Path == "/documents/doc-1/sections":
+			if r.Header.Get("Authorization") != "Bearer t" {
+				http.Error(w, "no token", http.StatusUnauthorized)
+				return
+			}
+			if r.URL.Query().Get("page") == "2" {
+				_, _ = w.Write([]byte(`{"data":[{"id":"s3","name":"Social disclosures"}]}`))
+				return
+			}
+			if r.URL.Query().Get("$maxpagesize") != "100" {
+				http.Error(w, "missing $maxpagesize", http.StatusBadRequest)
+				return
+			}
+			_, _ = fmt.Fprintf(w, `{"data":[{"id":"s1","name":"Environmental disclosures"},{"id":"s2","name":"Other"}],"@nextLink":%q}`,
+				srv.URL+"/documents/doc-1/sections?page=2")
+		case r.Method == http.MethodDelete && strings.HasPrefix(r.URL.Path, "/documents/doc-1/sections/"):
+			deletes = append(deletes, strings.TrimPrefix(r.URL.Path, "/documents/doc-1/sections/"))
+			w.WriteHeader(http.StatusNoContent)
+		default:
+			http.Error(w, "unexpected "+r.Method+" "+r.URL.String(), http.StatusTeapot)
+		}
+	}))
+	defer srv.Close()
+	base, err := url.Parse(srv.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	lw := newLiveWorkivaAt(base, "id", "secret", srv.Client())
+
+	got, err := lw.ListSections(context.Background(), "doc-1")
+	if err != nil {
+		t.Fatalf("ListSections: %v", err)
+	}
+	want := []Section{{"s1", "Environmental disclosures"}, {"s2", "Other"}, {"s3", "Social disclosures"}}
+	if len(got) != len(want) {
+		t.Fatalf("sections = %+v, want %+v", got, want)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("section %d = %+v, want %+v", i, got[i], want[i])
+		}
+	}
+
+	if err := lw.DeleteSection(context.Background(), "doc-1", "s1"); err != nil {
+		t.Fatalf("DeleteSection: %v", err)
+	}
+	if len(deletes) != 1 || deletes[0] != "s1" {
+		t.Errorf("deletes = %v", deletes)
+	}
+}
+
+func TestLiveWorkivaRefusesForeignNextLink(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/iam/v1/oauth2/token" {
+			_, _ = w.Write([]byte(`{"access_token":"t","expires_in":3600}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"data":[],"@nextLink":"https://evil.example/documents/d/sections?page=2"}`))
+	}))
+	defer srv.Close()
+	base, _ := url.Parse(srv.URL)
+	lw := newLiveWorkivaAt(base, "id", "secret", srv.Client())
+	if _, err := lw.ListSections(context.Background(), "d"); err == nil {
+		t.Error("a nextLink on another host was followed")
+	}
+}
+
+func TestLiveWorkivaDeleteRejectsOtherStatus(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/iam/v1/oauth2/token" {
+			_, _ = w.Write([]byte(`{"access_token":"t","expires_in":3600}`))
+			return
+		}
+		w.WriteHeader(http.StatusNotFound)
+		_ = json.NewEncoder(w).Encode(map[string]string{"message": "nope"})
+	}))
+	defer srv.Close()
+	base, _ := url.Parse(srv.URL)
+	lw := newLiveWorkivaAt(base, "id", "secret", srv.Client())
+	if err := lw.DeleteSection(context.Background(), "d", "s"); err == nil || !strings.Contains(err.Error(), "404") {
+		t.Errorf("err = %v, want status 404", err)
+	}
+}
+
+func TestNewWorkivaRequiresCredentials(t *testing.T) {
+	env := map[string]string{}
+	get := func(k string) string { return env[k] }
+	_, err := newLiveWorkivaFromEnv(get)
+	if err == nil || !strings.Contains(err.Error(), "NL_WORKIVA_CLIENT_ID") {
+		t.Fatalf("err = %v, want it to name NL_WORKIVA_CLIENT_ID", err)
+	}
+	env["NL_WORKIVA_CLIENT_ID"] = "the-id"
+	_, err = newLiveWorkivaFromEnv(get)
+	if err == nil || !strings.Contains(err.Error(), "NL_WORKIVA_CLIENT_SECRET") {
+		t.Fatalf("err = %v, want it to name NL_WORKIVA_CLIENT_SECRET", err)
+	}
+	env["NL_WORKIVA_CLIENT_SECRET"] = "the-secret-value"
+	env["NL_REGION"] = "mars"
+	_, err = newLiveWorkivaFromEnv(get)
+	if err == nil || !strings.Contains(err.Error(), "NL_REGION") {
+		t.Fatalf("err = %v, want it to name NL_REGION", err)
+	}
+	for _, e := range []error{err} {
+		if strings.Contains(e.Error(), "the-secret-value") || strings.Contains(e.Error(), "the-id") {
+			t.Errorf("error leaks a credential: %v", e)
+		}
+	}
+	for region, host := range map[string]string{"": "api.eu.wdesk.com", "eu": "api.eu.wdesk.com", "us": "api.app.wdesk.com", "apac": "api.apac.wdesk.com"} {
+		env["NL_REGION"] = region
+		base, err := regionBaseURL(region)
+		if err != nil || base.Host != host || base.Scheme != "https" {
+			t.Errorf("region %q: %v %v", region, base, err)
+		}
+		if _, err := newLiveWorkivaFromEnv(get); err != nil {
+			t.Errorf("region %q: %v", region, err)
+		}
+	}
+}
+
+// The default newWorkiva must never be the real one while tests run.
+func TestNewWorkivaSeamIsFakedInTests(t *testing.T) {
+	if _, err := newWorkiva(context.Background()); !errors.Is(err, errRealClientInTest) {
+		t.Errorf("newWorkiva = %v, want the test guard", err)
+	}
+}
