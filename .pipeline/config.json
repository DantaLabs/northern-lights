    "build": "go build ./..."
  },
  "detected_from": {
    "install": "go.mod",
    "test": ".github/workflows/ci.yml (go test ./... -race)",
    "lint": ".github/workflows/ci.yml (gofmt, go vet, golangci-lint v2.14.0)",
    "typecheck": "go.mod (compiler checks types during build)",
    "build": "go.mod",
    "default_branch": "demo sprint until 2026-11-02; set back to main after the demo merges"
  }
}
