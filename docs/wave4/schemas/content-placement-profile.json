{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northern-lights.invalid/schemas/content-placement-profile.json",
  "title": "Signed DestinationProfile payload",
  "$ref": "#/$defs/destinationProfile",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "policyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "retentionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "revision",
        "content_hash",
        "class"
      ],
      "properties": {
        "policy_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "class": {
          "enum": [
            "source",
            "draft",
            "workflow",
            "audit"
          ]
        }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_kind",
        "period",
        "currency",
        "unit",
        "stored_scale",
        "display_scale",
        "percent_basis",
        "precision"
      ],
      "properties": {
        "value_kind": {
          "enum": [
            "text",
            "number",
            "date",
            "boolean"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "stored_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000
        },
        "display_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000
        },
        "percent_basis": {
          "enum": [
            "not_percentage",
            "fraction",
            "whole_percent",
            "basis_points"
          ]
        },
        "precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 15
        }
      },
      "description": "Null means explicitly reviewed not-applicable, never unknown. Scales express verified multipliers relative to the named base unit. Missing or ambiguous applicable facts block staging; numeric/date/boolean/type and same-currency conversion consistency require semantic validation."
    },
    "metadataRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula",
        "protection",
        "writability",
        "formatting",
        "period",
        "currency",
        "unit",
        "scale",
        "percent_basis",
        "precision"
      ],
      "properties": {
        "formula": {
          "const": "provider_verified"
        },
        "protection": {
          "const": "provider_verified"
        },
        "writability": {
          "const": "provider_verified"
        },
        "formatting": {
          "const": "provider_verified"
        },
        "period": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        },
        "currency": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        },
        "unit": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        },
        "scale": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        },
        "percent_basis": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        },
        "precision": {
          "enum": [
            "provider_verified",
            "operator_declared_allowed"
          ]
        }
      }
    },
    "destinationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "destination_profile_id",
        "revision",
        "content_hash",
        "state",
        "resource_id",
        "sheet_id",
        "cell",
        "operation",
        "expected_interpretation",
        "formula_policy",
        "literal_policy",
        "protection_policy",
        "format_policy",
        "unknown_critical_facts",
        "provenance_requirement",
        "metadata_requirements",
        "allowed_conversions",
        "resource_policy",
        "conversion_policy",
        "provider_contract",
        "retention_policy",
        "preview_ttl_seconds"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "destination_profile_id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "content_hash": {
          "$ref": "#/$defs/hash"
        },
        "state": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "sheet_id": {
          "$ref": "#/$defs/id"
        },
        "cell": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
        },
        "operation": {
          "const": "single_cell_literal"
        },
        "expected_interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "formula_policy": {
          "const": "reject_formula_target"
        },
        "literal_policy": {
          "const": "literal_only"
        },
        "protection_policy": {
          "const": "reject_protected"
        },
        "format_policy": {
          "const": "preserve"
        },
        "unknown_critical_facts": {
          "const": "block"
        },
        "provenance_requirement": {
          "enum": [
            "source_or_verified_evidence",
            "fine_grained_available"
          ]
        },
        "metadata_requirements": {
          "$ref": "#/$defs/metadataRequirements"
        },
        "allowed_conversions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "typed_copy",
              "same_currency_scale",
              "verified_percentage"
            ]
          }
        },
        "resource_policy": {
          "$ref": "#/$defs/policyRef"
        },
        "conversion_policy": {
          "$ref": "#/$defs/policyRef"
        },
        "provider_contract": {
          "$ref": "#/$defs/policyRef"
        },
        "retention_policy": {
          "allOf": [
            {
              "$ref": "#/$defs/retentionRef"
            },
            {
              "properties": {
                "class": {
                  "const": "workflow"
                }
              }
            }
          ]
        },
        "preview_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "description": "Normative operator-authored payload carried by an authenticated signed bundle; not a chat-supplied mapping. Tenant comes from the containing bundle. content_hash is SHA-256 of versioned canonical profile bytes excluding its content_hash member. Signature verification, active-bundle membership, immutable revision/hash consistency, reference resolution, retention and authorization are runtime prerequisites. Unknown critical metadata blocks the affected stage. No formula, layout, multi-cell or bulk operation exists in this schema."
    }
  }
}
